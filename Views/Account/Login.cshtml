@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Sign In</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="exam-shell" style="max-width: 420px;">
        <div class="exam-card">
            <h1 class="exam-heading">Sign in</h1>
            <p class="exam-subtitle">Please sign in to view the portfolio.</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <form asp-action="Login" asp-controller="Account" method="post">
                <span class="field-label">Username</span>
                <input class="form-control-exam" type="text" name="username" placeholder="admin" required />

                <span class="field-label">Password</span>
                <input class="form-control-exam" type="password" name="password" placeholder="••••••••" required />

                <button type="submit" class="btn-exam" style="width:100%; justify-content:center; margin-top: 10px;">Sign in &rarr;</button>
            </form>
        </div>
    </div>
</body>
</html>
